# Database Configuration (SQLite default; PostgreSQL supported for production)
DATABASE_URL=sqlite:///./amulya.db

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Application Branding & Environment
COMPANY_NAME=AMULYA AGROTECH (P) LTD
ENVIRONMENT=development

# Public enquiry throttling (per client IP, per backend process)
PUBLIC_ENQUIRY_RATE_LIMIT=10
PUBLIC_ENQUIRY_RATE_WINDOW_SECONDS=60

# Email notifications. SMTP is the local default; Render's free web services
# block outbound SMTP. Use the HTTPS provider in production there.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=

# Local SMTP configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_EMAIL=
# Development/test use only. The API refuses to start in production with mock mode enabled.
SMTP_MOCK_MODE=false
